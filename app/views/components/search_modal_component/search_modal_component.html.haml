.c-search-modal
  .modal.fade#searchModal{"tabindex" => "-1", "aria-labelledby" => "searchModalLabel",
                          "aria-hidden" => "true", data: { controller: 'search-modal',
                                                           action: 'shown.bs.modal->search-modal#onModalShown', 'search-modal-target' => 'modal' } }
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header.border-0.pb-0
          %h5.modal-title.fw-bold#searchModalLabel= title
          %button.btn-close{"type" => "button", data: { "bs-dismiss" => "modal", 'search-modal-target' => 'closeButton' },
                            "aria-label" => "Close"}

        .modal-body.pt-2
          .search-form.mb-4
            = form_with **form_attrs do |form|
              = form.hidden_field :sort, name: 'q[order]', value: 'neighbor_distance asc'
              .position-relative
                .input-group.input-group-lg.shadow-sm.overflow-hidden
                  %span.input-group-text.bg-white.border-end-0
                    %i.bi.bi-search.text-muted
                  = form.search_field :term, name: 'q[term]', class: 'form-control border-start-0 ps-1',
                    placeholder: 'Search conversations...', required: true, minlength: 3,
                    'aria-label' => 'Search', autocomplete: 'off',
                    data: { 'search-modal-target' => 'input',
                            action: 'keydown.enter->search-modal#search:prevent' }
              .d-grid.gap-2.mt-3
                = form.submit 'Search', class: 'btn btn-primary btn-lg', id: 'search-button',
                  data: { action: 'click->search-modal#search:prevent'}
