.c-generate-image-request{ id:, data: { controller: 'generate-image-request tooltip' } }
  .turn.grid.mb-3
    .g-col-12
      .card
        .turn-icon.ps-3.pt-1
          %i.bi-robot
        .card-body.pt-1
          - if created? || in_progress?
            .text-center
              .text-muted.mb-3 Generating an image...
              = render SpinnerComponent.new
          - elsif failed?
            = t('failed_to_generate_image')
            = link_to conversation_conversation_turn_path(conversation, conversation_turn),
              class: 'float-end fs-5 btn icon-btn icon-btn-sm danger',
              data: { turbo_method: 'delete', turbo_confirm: t('confirm'),
                    'bs-toggle' => 'tooltip',
                    'bs-title' => t('delete', name: t('image')) } do
              %i.bi-trash3
          - else
            .generated-image.mb-3.d-flex.justify-content-center
              = image_tag image.variant(:webp), class: 'd-none', data: { 'generate-image-request-target' => 'image',
                                                                         action: 'click->generate-image-request#expandImage',
                                                                         'original-url' => url_for(image) }
              = render SpinnerComponent.new(css_class: 'text-center', 'data-generate-image-request-target': 'spinner')
            .tool-tray.d-flex.justify-content-between.align-items-center
              .buttons.d-flex.align-items-center
                = link_to blob_path(image.blob), data: { turbo: false, 'bs-toggle' => 'tooltip',
                                                         'bs-title' => t('download_image') },
                                                 class: 'btn icon-btn icon-btn-sm' do
                  %i.bi.bi-download.fs-5
                %a.btn.icon-btn.icon-btn-sm.more-info.me-2{ tabindex: 0, data: { 'generate-image-request-target' => 'moreInfo',
                                                                                 src: blob_detail_path(image.blob)  } }
                  %i.bi-info-square{ data: { 'bs-toggle' => 'tooltip', 'bs-title' => 'Info' } }
              .delete.justify-content-end.align-items-center
                = link_to conversation_conversation_turn_path(conversation, conversation_turn),
                  class: 'float-end fs-5 btn icon-btn icon-btn-sm danger',
                  data: { turbo_method: 'delete', turbo_confirm: t('confirm'),
                         'bs-toggle' => 'tooltip', 'bs-title' => t('delete', name: t('image')) } do
                  %i.bi-trash3
  - if completed?
    .modal.fade{ id: "imageModal-#{id}", tabindex: "-1", "aria-labelledby": "imageModalLabel-#{id}", "aria-hidden": "true",
                data: { 'generate-image-request-target': 'modal' } }
      .modal-dialog.modal-dialog-centered.modal-fullscreen
        .modal-content
          .modal-header
            %h5.modal-title{ id: "imageModalLabel-#{id}" }= image.blob.filename
            %button.btn-close{ type: "button", "data-bs-dismiss": "modal", "aria-label": "Close" }
          .modal-body.text-center
            %img.img-fluid{ data: { 'generate-image-request-target': 'fullImage' } }
          .modal-footer.d-flex
            = link_to blob_path(image.blob), data: { turbo: false, 'bs-toggle' => 'tooltip', 'bs-title' => t('download_image') },
                                            class: 'btn icon-btn icon-btn-sm' do
              %i.bi.bi-download.fs-5
