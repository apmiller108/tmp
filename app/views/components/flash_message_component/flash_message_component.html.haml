.c-flash-message.text-center.alert.alert-dismissible{ class: alert_class,
                                                     role: :alert,
                                                     data: { controller: 'flash-message',
                                                            auto_dismiss: auto_dismiss,
                                                            flash_message_target: 'container' } }
  .d-flex.align-items-center.justify-content-between
    .d-flex.align-items-center
      %i.bi.me-2.fs-4{ class: icon_class }
      %div.message-text= message
    %button.btn-close{type: :button,
                     data: { 'bs-dismiss' => :alert,
                            'flash-message-target' => 'closeButton' },
                     aria: { label: :close }}

  - if validation_errors?
    %hr.my-2
    .validation-errors.text-start.pb-2
      - errors.full_messages.each do |m|
        %p.mb-1= m
