.c-prompt-form.w-100{ id:, data: { controller: 'prompt-form', action: 'my-channel:generateText@window->prompt-form#onGenerateText',
                                   'conversation-id' => conversation.id } }
  = form_with model: conversation_form, scope: :conversation, url: polymorphic_path(conversation),
    data: { 'prompt-form-target' => 'form', action: 'direct-uploads:start->prompt-form#disableForm', **turbo_attrs } do |form|
    = form.hidden_field :turnable_type, value: 'GenerateTextRequest'
    = form.hidden_field :text_id, data: { 'prompt-form-target' => 'textId' }
    = form.hidden_field :stream, value: 1
    = form.hidden_field :image_quality, { data: { 'prompt-form-target' => 'imageQuality' } }
    = form.hidden_field :tool_types, { data: { 'prompt-form-target' => 'toolTypes' } }
    .grid{ style: '--bs-gap: 0.5rem;'}
      .g-col-12.form-container
        .options.d-flex.justify-content-start.align-items-center
          .mb-2
            %button.btn.fs-6.options-toggle-btn.p-0.mx-2{ 'data-bs-toggle' => 'collapse',
                                                          'data-bs-target' => '#advanced-options',
                                                          'data-prompt-form-target' => 'showOptionsButton',
                                                          'data-action' => 'click->prompt-form#onClickShowOptions:prevent' }
              %i.bi.bi-chevron-up{ data: { 'bs-toggle' => 'tooltip', 'bs-title' => 'toggle options' }}
          .collapse.mb-2#advanced-options{ data: { 'prompt-form-target' => 'options' } }
            .grid
              .g-col-3
                .form-floating
                  = form.select :model, model_options, {},
                  { class: 'form-select', data: { 'prompt-form-target' => 'modelSelect',
                                                  'model-data' => model_data, action: 'change->prompt-form#onChangeModel' } }
                  = form.label :model, 'Model'
              .g-col-3.d-flex.align-items-center
                .form-floating
                  = form.select :generate_text_preset_id, preset_options, { include_blank: true },
                    { class: 'form-select', data: { 'prompt-form-target' => 'presetSelect', 'preset-data' => preset_data,
                                                    action: 'change->prompt-form#onChangePreset' } }
                  = form.label :generate_text_preset_id, 'Preset'
                = link_to new_generate_text_preset_path(redirect_after_create: after_create_preset_redirect_path),
                  class: 'icon-btn', id: 'new_preset_link', data: { turbo_frame: '_top' } do
                  %i.bi.bi-plus{ data: { 'bs-toggle' => 'tooltip', 'bs-title' => t('generate_text_preset.add') }}
              .g-start-10.g-col-3
                .form-group
                  .d-flex.justify-content-between.align-items-center
                    .d-flex.justify-content-start.align-items-center
                      = form.label :temperature, 'Temperature', class: 'form-label mb-0'
                      %i.bi.bi-info-circle.ms-1.text-muted{ data: { 'bs-toggle' => 'tooltip',
                                                                    'bs-title' => 'Lower values produce more predictable outputs. Higher values produce more creative results' } }
                    %span.badge.ms-2{ data: { 'prompt-form-target' => 'temperatureValue' } }
                  .d-flex.align-items-center.gap-2
                    = form.range_field :temperature,
                                       min: 0,
                                       max: 1,
                                       step: 0.1,
                                       class: 'form-range',
                                       data: { 'prompt-form-target' => 'temperatureSlider',
                                               'action' => 'input->prompt-form#onTempInput' }
        .grid.prompt-input-container
          .g-col-12.position-relative
            = form.text_area :prompt, class: 'form-control scroll-no-bar-container', data: { 'prompt-form-target' => 'promptInput' },
                              placeholder: 'Type a message', rows: 2
            %button.btn.icon-btn{ type: 'submit', name: 'commit', data: { 'prompt-form-target' => 'submitButton' },
                                  disabled: disabled?}
              %i.bi.bi-send-fill
            .text-area-tray.d-flex.justify-content-center.align-items-center
              %button.btn.fs-6.p-0{ 'data-prompt-form-target' => 'toggleTextAreaButton',
                                    'data-action' => 'click->prompt-form#onToggleTextAreaSize:prevent' }
                %i.bi.bi-chevron-down{ data: { 'bs-toggle' => 'tooltip', 'bs-title' => 'Toggle text area size'} }
          .g-col-6.mt-1
            = render FileInputComponent.new(form:, disabled: file_input_disabled?, file_types:, max_size: max_file_size)

          .g-col-6.details-fields.p-0
            %div.d-flex.align-items-center.justify-content-end.mt-1
              %div.d-flex.align-items-center
                %span.label.me-2 Tokens:
                %pre.value= conversation.token_count
              %button.context-btn.btn.icon-btn.icon-btn-sm.ms-2{ type: 'button', data: { 'bs-toggle': 'modal', 'bs-target': '#convo-context-modal' }}
                %i.bi.bi-folder-plus{ data: { 'bs-toggle': 'tooltip', 'bs-title': 'Conversation Context' }}
              %button.settings-btn.btn.icon-btn.icon-btn-sm.ms-2{ type: 'button', data: { 'bs-toggle': 'modal', 'bs-target': '#convo-settings-modal' }}
                %i.bi.bi-gear{ data: { 'bs-toggle': 'tooltip', 'bs-title': 'Conversation Settings' }}

  -# CONVERSATION SETTINGS MODAL

  .modal.fade.settings-modal#convo-settings-modal{ tabindex: '-1', 'aria-labelledby': 'conversationSettingsModalLabel', 'aria-hidden': 'true' }
    .modal-dialog
      .modal-content
        .modal-header.bg-primary.text-white
          %h5.modal-title#conversationSettingsModalLabel Conversation Settings
          %button.btn-close.btn-close-white{ type: 'button', 'data-bs-dismiss': 'modal', 'aria-label': 'Close' }
        .modal-body
          .mb-3
            .form-floating.d-flex
              = select :conversation, :image_quality, Conversation.image_qualities, { include_blank: false, selected: conversation.image_quality },
                  { class: 'form-select', data: { 'action' => 'change->prompt-form#onImageQualityChange' } }
              = label :converstion, :image_quality, 'Text to Image Quality', class: 'form-label'
              %i.bi.bi-info-circle.ms-1.text-muted{ data: { 'bs-toggle' => 'tooltip',
                                                            'bs-title' => 'Select standard for faster generation times. Select high for photorealistic and professional print quality. Image to image will always be high quality' } }

          %h6.mb-3 AI Tools

          .llm-tools-container
            - LlmTool.active.pluck(:tool_type).uniq.each do |tool_type|
              .form-check.form-switch.mb-3
                = check_box :conversation, "tool_type_#{tool_type}", checked: conversation.tool_type?(tool_type), include_hidden: false,
                role: :switch, class: 'form-check-input', data: { action: 'change->prompt-form#toggleToolType', 'tool-type' => tool_type }
                %label.form-check-label{ for: "tool-type-#{tool_type}" }
                  = tool_type.titleize
                %i.bi.bi-info-circle.ms-1.text-muted{ data: { 'bs-toggle' => 'tooltip',
                                                              'bs-title': helpers.tool_type_description(tool_type) } }

  -# CONVERSATION CONTEXT MODAL

  .modal.fade.context-modal#convo-context-modal{ tabindex: '-1', 'aria-labelledby': 'conversationContextModalLabel', 'aria-hidden': 'true' }
    .modal-dialog
      .modal-content
        .modal-header.bg-primary.text-white
          %h5.modal-title#conversationContextModalLabel Conversation Context
          %button.btn-close.btn-close-white{ type: 'button', 'data-bs-dismiss': 'modal', 'aria-label': 'Close' }
        .modal-body{ data: { controller: 'conversation-context', 'conversation-id': conversation.id } }
          .mb-3
            %h6 Upload File
            %p.text-muted Add documents, images, or other files to provide context for this conversation.

          .upload-area.border.border-2.border-dashed.rounded.p-4.text-center.mb-3{ data: { 'conversation-context-target': 'dropZone', action: 'dragover->conversation-context#handleDragOver drop->conversation-context#handleDrop dragleave->conversation-context#handleDragLeave' } }
            %i.bi.bi-cloud-upload.fs-1.text-muted.mb-2
            %p.mb-2 Drag and drop a file here, or click to select
            %input.d-none{ type: 'file', data: { 'conversation-context-target': 'fileInput',
                                                 action: 'change->conversation-context#handleFileSelect' },
                           accept: '.pdf,.txt,.doc,.docx,.json,.csv,.jpg,.jpeg,.png,.gif' }
            %button.btn.btn-outline-primary{ type: 'button', data: { action: 'click->conversation-context#openFileDialog' } }
              %i.bi.bi-folder-plus.me-2
              Select File

          .alert.alert-success.d-none{ data: { 'conversation-context-target': 'successAlert' } }
            %i.bi.bi-check-circle.me-2
            %span{ data: { 'conversation-context-target': 'successMessage' } }

          .alert.alert-danger.d-none{ data: { 'conversation-context-target': 'errorAlert' } }
            %i.bi.bi-exclamation-triangle.me-2
            %span{ data: { 'conversation-context-target': 'errorMessage' } }

          .existing-files.mt-4{ data: { 'conversation-context-target': 'filesList' } }
            %h6 Context Files
            .files-container
              - if conversation.contexts.any?
                - conversation.contexts.order(created_at: :desc).each do |context|
                  .file-item.d-flex.justify-content-between.align-items-center.p-2.border.rounded.mb-2
                    .file-info.d-flex.align-items-center
                      %i.bi.bi-file-earmark.me-2.text-muted
                      .file-details
                        .file-name.fw-medium= context.filename
                        .file-meta.small.text-muted
                          = time_ago_in_words(context.created_at)
                          ago
                    .file-actions
                      %button.btn.btn-sm.btn-outline-danger{ type: 'button',
                                                             data: { action: 'click->conversation-context#deleteFile', 'file-id': context.id } }
                        %i.bi.bi-trash
              - else
                .text-muted.text-center.py-3
                  %i.bi.bi-folder.me-2
                  No context files uploaded yet
