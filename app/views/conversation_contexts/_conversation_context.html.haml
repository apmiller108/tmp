.context.list-group-item{ id: dom_id(context) }
  .d-flex.justify-content-between.align-items-start
    .d-flex.flex-column
      %h5.mb-1= context.filename
      %p.text-muted.mb-1= context.mime_type
    .d-flex.flex-column.align-items-end
      %span.updated_at.mb-2= "Created #{time_ago_in_words(context.created_at)} ago"
      .d-flex.justify-content-end
        %span.badge.bg-primary= "Used in #{context.conversations.to_a.size} #{'conversation'.pluralize(context.conversations.to_a.size)}"
  %div{ data: { controller: 'tooltip' }}
    = link_to context, data: { turbo_method: 'delete', turbo_confirm: 'Are you sure you want to delete this conversation context?',
                              'bs-toggle' => 'tooltip', 'bs-title' => 'Delete' },
                              class: 'btn icon-btn icon-btn-sm' do
      %i.bi.bi-trash3.text-danger