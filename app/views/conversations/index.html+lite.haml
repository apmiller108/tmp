%turbo-frame#conversation-index-lite
  %div{ data: { controller: 'conversation-index-lite' } }
    .list-group
      - @conversations.limit(3).each do |conversation|
        .conversation-item.d-flex.align-items-center.py-2.px-3.list-group-item.list-group-item-action.border.border-0{
          style: 'cursor: pointer;',
          data: {
            action: "click->conversation-index-lite#onItemClick",
            conversation_index_lite_target: 'item',
            conversation_id: conversation.id,
            conversation_title: conversation.title
          }
        }
          %i.bi.bi-chat-right-text.me-2
          %span= conversation.title

