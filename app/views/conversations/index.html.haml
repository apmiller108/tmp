.container.mt-2
  .grid.mb-4
    .g-col-6.mb-2
      = link_to 'New Conversation', new_conversation_path, class: 'btn btn-primary'
    .g-col-6
      = form_with(url: conversations_path, method: :get, class: 'form-inline justify-content-end') do |f|
        .input-group
          = f.text_field :query, placeholder: 'Search conversations', class: 'form-control'
          = f.submit 'Search', class: 'btn btn-outline-secondary'

  = render PaginationComponent.new(path: [:conversations_path]) do |pagination|
    = pagination.with_container do
      #conversations.list-group

