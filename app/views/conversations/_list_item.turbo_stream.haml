.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center.mb-1.ps-3{ id: list_dom_id(conversation),
                                                                    data: { 'conversation-left-panel-target' => 'listItem',
                                                                            conversation_id: conversation.id } }
  .d-flex.justify-content-between.w-100
    = link_to edit_conversation_path(conversation), data: { turbo_frame: :conversation_content,
                                                            turbo_prefetch: false, turbo_action: :advance },
    class: 'convo-edit-link' do
      %div= truncate(conversation.title, length: 50, separator: ' ')
    = link_to conversation_path(conversation),
      id: dom_id(conversation, 'delete'),
      class: 'fs-5 btn icon-btn icon-btn-sm danger',
      disabled: conversation.memo_id.present?,
      data: { turbo_method: 'delete', turbo_confirm: t('confirm'),
            'bs-toggle' => 'tooltip',
            'bs-title' => t('delete', name: t('conversation.name')) } do
      %i.bi-trash3
  .meta-data
    %p.text-muted.mb-0
      %small= conversation.updated_at.strftime('%B %d, %Y')
