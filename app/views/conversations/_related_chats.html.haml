.related-chats{ class: [hidden && 'd-none'], data: { controller: 'related-chats',
                        conversation_id: conversation_id,
                        action: 'conversation:conversationLoaded@window->related-chats#onConversationLoaded my-channel:embeddingCreated@window->related-chats#reload conversation-index-lite:itemClicked->related-chats#showConversation'  } }

  .related-chats-heading
    %strong.ms-3 Related to this chat
    %hr.my-2.ms-3
  %turbo-frame#conversation-index-lite{ src: conversations_url(q: { conversation_id: conversation_id, order: 'neighbor_distance asc' },
                                                               variant: :lite), loading: :lazy,
                                        data: { related_chats_target: 'turboFrame'} }
    .d-flex.justify-content-center.align-items-center.pt-5
      = render SpinnerComponent.new

  <!-- Modal for Related Chat -->
  .modal.fade#relatedChatModal{ tabindex: "-1", "aria-labelledby": "relatedChatModalLabel", "aria-hidden": "true",
                              data: { related_chats_target: 'modal' } }
    .modal-dialog.modal-dialog-scrollable.modal-lg{ data: { related_chats_target: 'modalContent' } }
      .modal-content
        .modal-header.bg-primary.text-white
          %h5.modal-title{ data: { related_chats_target: 'modalTitle' } } Related Chat
          %button.btn.icon-btn.icon-btn-sm.white{ data: { action: 'click->related-chats#toggleModalSize'} }
            %i.bi.bi-arrows-angle-expand
        .modal-body
          %turbo-frame#conversation-show{ src: "", loading: "lazy", data: { related_chats_target: "modalFrame" } }
            .d-flex.justify-content-center.align-items-center.py-5
              = render SpinnerComponent.new
        .modal-footer
          %button.btn.btn-secondary.text-white{ type: "button", "data-bs-dismiss": "modal" } Close
          %a.btn.btn-primary#goToConversationBtn{ href: "#",
                                                  data: { related_chats_target: 'modalEditLink',
                                                          action: 'click->related-chats#onEditLinkClick',
                                                          turbo_frame: :conversation_content,
                                                          turbo_action: :advance} } Go to Conversation
