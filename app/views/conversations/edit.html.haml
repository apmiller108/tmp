= turbo_frame_tag :conversation_content do
  .conversation-title.container.mb-1{ data: { controller: 'tooltip' } }
    %div
      = render partial: 'title_form', locals: { conversation_form: @conversation_form, conversation: @conversation }
  = render ConversationComponent.new(conversation_form: @conversation_form)
= turbo_stream.update :conversation_scroll_spy do
  = render ScrollspyComponent.new(container_id: 'conversation_component', target_id: 'conversation-nav',
                                  action: 'conversation:turnsChanged@window->scrollspy#refresh') do |scrollspy|
    - @conversation.turns.each do |turn|
      - icon_class = turn.text? ? 'bi-body-text' : 'bi-file-earmark-image'
      - scrollspy.with_item do
        = render ScrollspyNavItemComponent.new(text: turn.turnable.prompt, icon_class:, href: "##{dom_id(turn)}", id: dom_id(turn, 'nav_item'))
= content_for :related_chats do
  %turbo-frame#related-chats{ src: conversations_path(q: { conversation_id: @conversation.id, order: 'neighbor_distance asc' },
                                                      variant: :lite),
                             loading: :lazy, data: { conversation_id: @conversation.id, controller: 'related-chats',
                                                     related_chats_target: 'turboFrame',
                                                     action: 'conversation:conversationLoaded@window->related-chats#onConversationLoaded my-channel:embeddingCreated@window->related-chats#reload' } }
    .d-flex.justify-content-center.align-items-center.pt-5
      = render SpinnerComponent.new
