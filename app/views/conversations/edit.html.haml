= content_for :title do
  .conversation-title.container.mb-1.grid{ data: { controller: 'tooltip' } }
    .g-start-5.g-col-4
      = render partial: 'conversations/title_form', locals: { conversation_form: @conversation_form, conversation: @conversation }
    .g-col-2.d-flex.align-items-center.justify-content-end
      - if @conversation.memo.nil?
        = button_to [@conversation], method: :delete, data: { turbo: false,
                                                'bs-toggle' => 'tooltip', 'bs-title' => t('conversation.delete') },
                                                class: 'btn icon-btn icon-btn-sm' do
          %i.bi.bi-trash3.text-danger
= content_for :left_side_panel do
  %turbo-frame{ id: :conversations_index, src: conversations_path, loading: :lazy }
= render ConversationComponent.new(conversation_form: @conversation_form)
= content_for :right_side_panel do
  RIGHT SIDE PANEL
