!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Tmp
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    = csrf_meta_tags
    = csp_meta_tag
    = action_cable_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_include_tag "application", "data-turbo-track": "reload", defer: true
    = hotwire_livereload_tags if Rails.env.development?
  %body
    .main.vh-100.d-flex.flex-column.overflow-hidden.position-relative
      -# = render partial: 'layouts/nav'
      = render partial: 'layouts/flash'
      .grid
        .g-col-12.h-auto
          = yield :title
      .grid.h-100
        .g-col-2.conversation-left-side-panel.pb-3.scroll-no-bar-container.container-sm
          = yield :left_side_panel
        .g-col-8.conversation-content.scroll-no-bar-container.pb-3
          = yield
        .g-col-2.conversation-right-side-panel.pb-3
          = yield :right_side_panel
