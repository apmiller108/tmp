!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Tmp
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    = csrf_meta_tags
    = csp_meta_tag
    = action_cable_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_include_tag "application", "data-turbo-track": "reload", defer: true
    = hotwire_livereload_tags if Rails.env.development?
  %body
    .main.vh-100.d-flex.flex-column.overflow-hidden.position-relative.conversation-main{ data: { controller: 'my-channel '} }
      = turbo_stream_from current_user, TurboStreams::STREAMS[:main]
      #alert-stream
      .d-flex.h-100{ style: '--bs-gap: 1rem;'}

        <!-- Left Panel -->
        .left-panel.pb-3
          .h-100.conversation-left-panel{ data: { controller: 'conversation-left-panel',
                                          action: 'conversation:conversationLoaded@window->conversation-left-panel#onConversationLoaded' } }
            .controls.d-flex.justify-content-between.mb-3.ps-3{ data: { controller: 'tooltip',
                                                                        'conversation-left-panel-target' => 'controls' } }
              %button.btn.icon-btn.icon-btn-auto{ data: { 'bs-toggle' => 'collapse', 'bs-target' => '#conversation-list' } }
                %i.bi.bi-arrows-collapse-vertical{ data: { 'conversation-left-panel-target' => 'collapseIcon',
                                                          'bs-toggle' => 'tooltip', 'bs-title' => 'Toggle Section' }}
              .d-flex.justify-content-between
                %button#search-btn.btn.icon-btn.icon-btn-auto.me-3{ data: { 'bs-toggle' => 'modal',
                                                                            'bs-target' => '#searchModal' } }
                  %i.bi.bi-search{ data: { 'bs-toggle' => 'tooltip', 'bs-title' => t('conversation.search') } }
                = button_to conversations_path, method: :post, params: { conversation: { title: Conversation.default_title } },
                class: 'btn icon-btn icon-btn-auto', id: 'new-conversation',
                data: { turbo_frame: :conversation_content, turbo_action: :advance,
                        action: 'click->conversation-left-panel#onNewConversation',
                        'bs-toggle' => 'tooltip', 'bs-title' => t('conversation.new') } do
                  %i.bi.bi-pencil-square
            #conversation-list.h-100.collapse.show.collapse-horizontal{data: { 'conversation-left-panel-target' => 'conversationsIndex',
              action: 'hidden.bs.collapse->conversation-left-panel#onHidePanel show.bs.collapse->conversation-left-panel#onShowPanel' } }
              %turbo-frame{ id: :conversations_index, src: conversations_path,
                           data: { action: 'turbo:frame-render->conversation-left-panel#onIndexInitialized' } }

        <!-- Middle Panel -->
        .conversation-content.flex-grow-1.pb-3
          %turbo-frame.conversation-content{ id: :conversation_content }
            = yield

        <!-- Right Panel -->
        .right-panel.pb-3.d-flex.flex-column{ data: { controller: 'conversation-right-panel tooltip',
               action: 'scrollspy:navItemsChanged@window->conversation-right-panel#onNavItemsChanged' } }
          .controls.d-flex.justify-content-between.align-items-center.mb-3.pe-3{ data: { 'conversation-right-panel-target' => 'controls',
                                                                                          controller: 'tooltip' } }
            .d-flex.justify-content-between.align-items-center
              %nav.navbar.d-flex.justify-content-end
                %button.btn.icon-btn.icon-btn-auto.me-3{"data-bs-toggle" => "offcanvas", "data-bs-target" => "#offcanvasNavbar",
                                                        "aria-controls" => "offcanvasNavbar", "aria-label" => "Toggle navigation"}
                  %i.bi.bi-justify-right
                = render partial: 'layouts/offcanvas_nav'
              = link_to generate_text_presets_path, class: 'btn icon-btn icon-btn-auto' do
                %i.bi.bi-sliders{ data: { 'bs-toggle' => 'tooltip', 'bs-title' => 'Presets' }}
            %button.btn.icon-btn.icon-btn-auto{ data: { 'bs-toggle' => 'collapse', 'bs-target' => '.right-panel-collapsible' } }
              %i.bi.bi-arrows-collapse-vertical{ data: { 'conversation-right-panel-target' => 'collapseIcon',
                                                        'bs-toggle' => 'tooltip', 'bs-title' => 'Toggle Section' }}

          .scrollspy-heading.right-panel-collapsible.collapse.show.collapse-horizontal
            %strong.ms-3 In this chat
            %hr.my-2.ms-3
          #conversation_scroll_spy.conversation-scrollspy.right-panel-collapsible.collapse.show.collapse-horizontal{
          data: { 'conversation-right-panel-target' => 'scrollspy',
          action: 'hidden.bs.collapse->conversation-right-panel#onHidePanel show.bs.collapse->conversation-right-panel#onShowPanel' } }

          <!-- Related Chats Section -->
          #related_conversations.related-conversations.right-panel-collapsible.collapse.show.collapse-horizontal.pb-3.mt-3
            = yield :related_chats
    <!-- Search Modal -->
    = render SearchModalComponent.new(path: conversations_path, title: 'Search Conversations',
                                      form_attrs: { data: { turbo_frame: :conversations_index, action: 'conversation-left-panel:conversationIndexInitialized@window->search-modal#close' } })
