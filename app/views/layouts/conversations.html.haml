!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Tmp
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    = csrf_meta_tags
    = csp_meta_tag
    = action_cable_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_include_tag "application", "data-turbo-track": "reload", defer: true
    = hotwire_livereload_tags if Rails.env.development?
  %body
    .main.vh-100.d-flex.flex-column.overflow-hidden.position-relative
      = render partial: 'layouts/flash'
      .d-flex.h-100{ style: '--bs-gap: 1rem;'}
        .conversation-left-side-panel.scroll-no-bar-container.pb-3.ps-3.w-25
          = yield :left_side_panel
        .flex-grow-1.conversation-content.scroll-no-bar-container.pb-3
          = yield :title
          = yield
        .conversation-right-side-panel.pb-3.pe-3.w-25
          = yield :right_side_panel
