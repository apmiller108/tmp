.context-item.d-flex.justify-content-between.align-items-center.p-2.border.rounded.mb-2{ id: dom_id(conversation_context)}
  .context-info.d-flex.align-items-center
    %i.bi.bi-file-earmark.me-2.text-muted
    .context-details
      .file-name.fw-medium= conversation_context.context.filename
  .context-actions
    = link_to conversation_conversation_contexts_conversation_path(conversation_context.conversation_id, conversation_context),
      id: dom_id(conversation_context, 'delete'),
      class: 'fs-5 btn icon-btn icon-btn-sm danger',
      data: { turbo_method: 'delete', 'bs-toggle' => 'tooltip', 'bs-title' => t('delete', name: 'context') } do
      %i.bi-trash3
